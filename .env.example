APP_NAME="Reverb Server"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ws.reverb.maktechlaravel.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# A standalone Reverb server needs no real database. SQLite only exists so the
# Laravel framework can boot. No migrations are required at runtime.
DB_CONNECTION=sqlite

# ─── No sessions / cache / queue needed on the WebSocket server ───────────────
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# ─── Reverb app credentials ───────────────────────────────────────────────────
# MUST match REVERB_APP_* in reverb_backend and VITE_REVERB_APP_KEY in the
# frontend EXACTLY. Generate once and store in your secrets manager.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ─── Where this Reverb process binds (always 0.0.0.0 inside Docker) ───────────
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ─── Public hostname clients use to reach Reverb (advertised to clients) ──────
REVERB_HOST=ws.reverb.maktechlaravel.cloud
REVERB_PORT=443
REVERB_SCHEME=https

# ─── Allowed WebSocket origins ────────────────────────────────────────────────
# Reverb matches these against the HOST of the browser Origin header.
# Use BARE HOSTNAMES — no https://, no port. Wildcards ok (*.example.com). "*" = all.
# WRONG: https://reverb.maktechlaravel.cloud   RIGHT: reverb.maktechlaravel.cloud
REVERB_ALLOWED_ORIGINS=reverb.maktechlaravel.cloud,localhost,127.0.0.1,*.maktechlaravel.cloud

# ─── Horizontal scaling (optional — requires a shared Redis) ──────────────────
# REVERB_SCALING_ENABLED=true
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
