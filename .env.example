APP_NAME="next-template Reverb"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# A standalone Reverb server needs no real database. SQLite only exists so the
# Laravel framework can boot. No migrations are required at runtime.
DB_CONNECTION=sqlite

# ─── No sessions / cache / queue needed on the WebSocket server ───────────────
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# ─── Reverb app credentials ───────────────────────────────────────────────────
# Source of truth. Copy the same REVERB_APP_* onto next-template-api.
# Next only receives the public key as NEXT_PUBLIC_REVERB_APP_KEY.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ─── Where this Reverb process binds (always 0.0.0.0 inside Docker) ───────────
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ─── Public hostname clients use to reach Reverb (advertised to clients) ──────
# Local: localhost:8080 / http. Production: public WSS hostname, port 443, https.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── Allowed WebSocket origins ────────────────────────────────────────────────
# Reverb matches these against the HOST of the browser Origin header.
# Use BARE HOSTNAMES — no https://, no port. Wildcards ok (*.example.com). "*" = all.
# WRONG: https://localhost:3000   RIGHT: localhost
# Production: the Next.js hostname (Vercel), not the WebSocket hostname.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# ─── Horizontal scaling (optional — requires a shared Redis) ──────────────────
# REVERB_SCALING_ENABLED=true
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
